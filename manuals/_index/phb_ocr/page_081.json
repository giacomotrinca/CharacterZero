   "x1": 657.0,
   "y1": 833.0,
   "x2": 1151.0,
   "y2": 859.0,
   "text": "sapiente. Infine si scelgono i trucchetti luce, mano magica,"
  },
  {
   "x1": 107.0,
   "y1": 850.0,
   "x2": 604.0,
   "y2": 875.0,

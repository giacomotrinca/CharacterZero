   "x2": 574.0,
   "y2": 1034.0,
   "text": "e ai loro laboratori per condurli verso antichi complessi"
  },
  {
   "x1": 656.0,
   "y1": 1009.0,
   "x2": 1042.0,
   "y2": 1034.0,

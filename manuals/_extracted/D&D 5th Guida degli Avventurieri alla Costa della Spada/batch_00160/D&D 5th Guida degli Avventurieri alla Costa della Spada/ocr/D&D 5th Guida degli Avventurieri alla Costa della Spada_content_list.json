 },
 {
  "type": "text",
  "text": "» A GaleForce”",
  "page_idx": 1
 },
 {
  "type": "text",
  "text": "DUNGLONS AND DRAGONS, D&D, Plavers",
  "page_idx": 1
 },
 {
  "type": "title",
  "text": "BENVENUTI SULLA =",
  "page_idx": 3,
  "text_level": 1
 },
 {
  "type": "title",
  "text": "COSTA DELLA SPADA",
  "page_idx": 3,
  "text_level": 1
 },
 {
  "type": "text",
  "text": "La Costa della Spada. una regione dei",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "Forgotten Realms. ospita sfavillanti",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "insediamenti civilizzati e pericolose zone",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "infestate dal male. immerse in una vasta",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "distesa selvaggia che offre a un esploratore",
  "page_idx": 3
 },
 {
  "type": "title",
  "text": "innumerevoli opportunità e grandi minacce",
  "page_idx": 3,
  "text_level": 2
 },
 {
  "type": "text",
  "text": "in egual misura.",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "La Guida degli Avventurieri alla Costa",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "della Spada e una preziosa risorsa sia per il",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "Dungeon Master che per i giocatori. Oltre a",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "descrivere i popoli e i luoghi della Costa della",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "Spada. questo volume contiene un'ampia",
  "page_idx": 3
 },
 {
  "type": "title",
  "text": "gamma di nuove opzioni per i personaggi",
  "page_idx": 3,
  "text_level": 2
 },
 {
  "type": "text",
  "text": "che non manchera di incuriosire e ispirare",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "qualsiasi gruppo di avventurieri.",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "Da usare con la quinta edizione del",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "Player 's Handbook. del Monster Manuale",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "della Dungeon Guide. Questo libro",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "contiene le informazioni per l'ambientazione.",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "le storie e le opzioni dei personaggi richieste",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "per partecipare alle avventure di D&D",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "ambientate in qualsiasi angolo della Costa",
  "page_idx": 3
 },
 {
  "type": "text",
  "text": "della Spada nel Faerun.",
  "page_idx": 3
 },
 {
  "type": "title",
  "text": "È",
  "page_idx": 3,
  "text_level": 1
 },
 {
  "type": "text",
  "text": "DUNGEONSANDDRAGONS.COM",
  "page_idx": 3
 }
